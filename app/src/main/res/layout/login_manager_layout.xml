<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#03A9F4"
    android:foregroundTint="#03A9F4"
    app:barrierMargin="10dp">
    <TextView
        android:id="@+id/CompanyNameLine"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="-4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginBottom="661dp"
        android:width="420dp"
        android:height="70dp"
        android:background="@color/corporat_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/CompanyName"
        tools:layout_editor_absoluteX="-3dp"
        tools:layout_editor_absoluteY="-3dp"
        android:layout_width="414dp"
        android:layout_height="59dp"
        android:background="@color/white"
        android:paddingTop="10px"
        android:text="CompanyName"
        android:textAlignment="center"
        android:textColor="@color/corporat_blue"
        android:textSize="30dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/CompanyNameLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:layout_width="81dp"
        android:layout_height="67dp"
        android:padding="0dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"

        android:text="⬅"
        android:textAlignment="center"
        android:textSize="40dp"
        android:textStyle="bold"


        tools:layout_editor_absoluteX="7dp"
        tools:layout_editor_absoluteY="83dp" />

</androidx.constraintlayout.widget.ConstraintLayout>