<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/employee_login_screen"
    android:layout_height="match_parent"
    android:backgroundTint="#03A9F4"
    android:foregroundTint="#03A9F4"
    app:barrierMargin="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">


            <TextView
                android:id="@+id/CompanyName"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:background="@color/white"
                android:paddingTop="10px"
                android:text="CompanyName"
                android:textAlignment="center"
                android:textColor="@color/corporate_blue"
                android:textSize="30dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/companynameline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:width="420dp"
                android:height="30dp"
                android:background="@color/corporate_blue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="30dp">
                <Button
                    android:id="@+id/backbtn"
                    android:layout_width="62dp"
                    android:layout_height="72dp"
                    android:paddingTop="10dp"
                    android:text="↩︎"
                    android:textAlignment="center"
                    android:textSize="30dp"
                    android:textStyle="bold"
                    android:layout_marginRight="65dp"
                    android:backgroundTint="@color/date_button"/>

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Employee"
                    android:textStyle="bold"
                    android:textSize="30dp"
                    android:textColor="@color/dark_txt"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="30dp">
                <TextView
                    android:id="@+id/usernamelbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingRight="40dp"
                    android:layout_marginLeft="30dp"
                    android:text="Username"
                    android:textSize="25sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayout2"
                    android:layout_width="219dp"
                    android:layout_height="67dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="213dp"
                        android:layout_height="56dp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="30dp">
                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"

                    android:paddingRight="40dp"
                    android:layout_marginLeft="30dp"
                    android:textSize="25sp"
                    />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayout3"
                    android:layout_width="213dp"
                    android:layout_height="56dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>


            </LinearLayout>

            <Button
                android:id="@+id/loginbtn"
                android:layout_width="232dp"
                android:layout_height="125dp"
                android:layout_marginLeft="73dp"
                android:text="Login"
                android:textSize="30dp"
                android:backgroundTint="@color/date_button"/>

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>