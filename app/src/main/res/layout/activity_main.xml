<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#03A9F4"
    android:foregroundTint="#03A9F4"
    app:barrierMargin="10dp"
    android:id="@+id/main">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">


            <TextView
                android:id="@+id/CompanyName"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:background="@color/white"
                android:paddingTop="10px"
                android:text="CompanyName"
                android:textAlignment="center"
                android:textColor="@color/corporate_blue"
                android:textSize="30dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/companynameline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:width="420dp"
                android:height="30dp"
                android:background="@color/corporate_blue" />
        </LinearLayout>
        <TextView
            android:id="@+id/textView2"
            android:layout_width="120dp"
            android:layout_height="74dp"


            android:layout_marginStart="173dp"
            android:layout_marginTop="50dp"
            android:fontFamily="sans-serif"
            android:text="Login"
            android:textSize="35sp"
            android:textColor="@color/txt"
            />

        <Button
            android:id="@+id/button"
            android:layout_width="234dp"
            android:layout_height="112dp"
            android:text="Manager"
            android:textSize="25dp"
            android:layout_marginLeft="92dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/date_button"/>

        <Button
            android:id="@+id/employeelog"
            android:layout_width="234dp"
            android:layout_height="112dp"
            android:text="Employee"
            android:textSize="25dp"
            android:layout_marginLeft="92dp"
            android:backgroundTint="@color/date_button"/>




    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>