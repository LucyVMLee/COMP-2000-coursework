<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/confirm_booking_request">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="50dp">
            <com.google.android.material.navigation.NavigationView
                android:id="@+id/navigationView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textView4"

                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="60dp"
                    android:width="420dp"
                    android:height="70dp"
                    android:background="@color/corporate_blue" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="61dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="0dp"
                        android:text="Logo"
                        android:textSize="20dp" />

                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="481dp"
                        android:layout_height="58dp"

                        android:layout_marginTop="0dp"
                        android:layout_marginRight="65dp"
                        android:background="@color/white"
                        android:paddingLeft="155dp"
                        android:paddingTop="10px"

                        android:text="CompanyName"

                        android:textAlignment="center"
                        android:textColor="@color/corporate_blue"
                        android:textSize="30dp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/profilebutton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginLeft="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginRight="0dp"
                        android:layout_weight="1"
                        android:text="Profile" />


                </LinearLayout>

            </com.google.android.material.navigation.NavigationView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You are going to book Meeting room 3 for 29th January 2027"
                android:textSize="30dp"
                android:textAlignment="center"
                android:layout_marginRight="30dp"
                android:layout_marginLeft="30dp"
                android:paddingTop="20dp"/>
            <Button
                android:id="@+id/confirm_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Confirm"
                android:textSize="25dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:layout_marginRight="25dp"
                android:layout_marginLeft="25dp"
                android:layout_marginBottom="20dp"/>
            <Button
                android:id="@+id/change_booking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Change"
                android:textSize="25dp"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:layout_marginRight="25dp"
                android:layout_marginLeft="25dp"/>


        </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>