<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/book_a_room">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.navigation.NavigationView
                android:id="@+id/navigationView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textView4"

                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="60dp"
                    android:width="420dp"
                    android:height="70dp"
                    android:background="@color/corporate_blue" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="61dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="0dp"
                        android:text="Logo"
                        android:layout_marginRight="30dp"
                        android:textSize="20dp" />

                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="399dp"
                        android:layout_height="55dp"

                        android:layout_marginTop="0dp"
                        android:layout_marginRight="145dp"
                        android:background="@color/white"
                        android:paddingLeft="175dp"
                        android:paddingTop="10px"
                        android:text="CompanyName"
                        android:textAlignment="center"
                        android:textColor="@color/corporate_blue"
                        android:textSize="30dp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/profilebutton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginLeft="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_marginRight="0dp"
                        android:layout_weight="1"
                        android:text="Profile" />


                </LinearLayout>

            </com.google.android.material.navigation.NavigationView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/backbtn"
                    android:layout_width="62dp"
                    android:layout_height="72dp"

                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="139dp"
                    android:padding="0dp"

                    android:paddingTop="10dp"
                    android:text="↩︎"
                    android:textAlignment="center"
                    android:textSize="30dp"
                    android:textStyle="bold" />

                
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="420dp"
                    android:layout_height="61dp"
                    android:layout_marginLeft="40dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Title" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Booking for 29/01/2027 at 11am"
                    android:textAlignment="center"
                    android:textSize="30dp"
                    android:layout_marginTop="15dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rooms available:"
                    android:textSize="25dp"
                    android:textAlignment="center"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"/>
                
                <Button
                    android:id="@+id/meetingroom1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meeting Room 1 - capactity = 8"
                    android:textSize="20dp"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginBottom="15dp"/>
                <Button
                    android:id="@+id/meetingroom3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meeting Room 3 - capactity = 8"
                    android:textSize="20dp"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginBottom="15dp"/>

                <Button
                    android:id="@+id/metingroom4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meeting Room 4 - capactity = 8"
                    android:textSize="20dp"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginBottom="15dp"/>
                <Button
                    android:id="@+id/meeetingroom5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meeting Room 5 - capactity = 8"
                    android:textSize="20dp"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginBottom="15dp"/>
                <Button
                    android:id="@+id/seminarroom2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seminar room 2 - capactity = 20"
                    android:textSize="20dp"
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginBottom="15dp"/>
                    
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>